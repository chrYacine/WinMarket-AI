# Configuration generee hors Git par scripts/local_env.py ; cles LLM facultatives.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
LLM_PROVIDER_PRIORITY=anthropic,openai,mistral
LLM_TEMPERATURE=0.1
LLM_TEMPERATURE_FACTUAL=0.1
LLM_TEMPERATURE_GENERATION=0.3
LLM_TIMEOUT_SECONDS=60
PAPPERS_API_TOKEN=

# ============================================================================
# V3 — SaaS : base de données, session, stockage, email
# ============================================================================
# PostgreSQL uniquement (local, Docker, Supabase, Neon, ou tout Postgres
# managé) — le code ne dépend jamais du fournisseur, seulement de cette URL.
# Lot 56 : PostgreSQL local isole, port distinct de 5432, noms wm56_.
DATABASE_URL=

# Secret de signature des cookies de session et CSRF (itsdangerous).
# Génère une valeur aléatoire longue, par ex. : python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

ADMIN_NOTIFICATION_EMAIL=

APP_ENV=development
BASE_URL=http://127.0.0.1:8056

# STORAGE_BACKEND=local est la seule valeur implémentée pour le moment
# (voir src/web/storage/service.py) — l'interface est prête pour "object"
# (Supabase Storage / S3) sans changement côté appelants.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=data

# Si vide, les emails admin (nouvelle inscription, nouveau contact) sont
# simplement journalisés sans être envoyés — aucune erreur utilisateur.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
